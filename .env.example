# Copy to .env before running Docker Compose. These values are for local development.
# Replace every password and secret before exposing any service beyond localhost.

POSTGRES_APP_DB=local_ai_app
POSTGRES_APP_USER=local_ai_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-password

POSTGRES_VECTOR_DB=local_ai_vectors
POSTGRES_VECTOR_USER=local_ai_vectors
POSTGRES_VECTOR_PASSWORD=replace-with-a-different-long-random-password

POSTGRES_KEYCLOAK_DB=keycloak
POSTGRES_KEYCLOAK_USER=keycloak
POSTGRES_KEYCLOAK_PASSWORD=replace-with-another-long-random-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_REALM=local-ai
KEYCLOAK_CLIENT_ID=local-ai-frontend
# Optional. Configure a Keycloak audience mapper before setting this.
KEYCLOAK_EXPECTED_AUDIENCE=

# Defaults bind published ports to loopback only.
KEYCLOAK_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
OLLAMA_PORT=11434
NEXT_PUBLIC_API_URL=http://localhost:8000

# Registration mail defaults to the local Mailpit service. For a real SMTP provider,
# set the host, port, sender, TLS mode, username, and password on the backend only.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM=no-reply@local-ai.local

# Model names are configured here for later backend integration.
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
